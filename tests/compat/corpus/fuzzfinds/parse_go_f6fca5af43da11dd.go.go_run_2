          "id": "ad6752780464bc8c",
          "pos": {
            "end_col": 3,
            "end_line": 149,
            "end_offset": 3986,
            "start_col": 68,
            "start_line": 104,
            "start_offset": 2619
          },
          "roles": [
            "Body"
          ],
          "token": "{\n\tvar errs []string\n\tfi, err := os.Stat(fileName)\n\tif err != nil {\n\t\terrs = append(errs, \"Cannot access \"+fileName+\": \"+err.Error())\n\t\treturn nil, nil, errs\n\t}\n\tif fi.Size() == 0 {\n\t\terrs = append(errs, \"Cannot parse \"+fileName+\": file size is 0\")\n\t\treturn nil, nil, errs\n\t}\n\tbuffer, err := ioutil.ReadFile(fileName)\n\tif err != nil {\n\t\terrs = append(errs, \"Cannot read \"+fileName+\": \"+err.Error())\n\t\treturn nil, nil, errs\n\t}\n\tmessage := pb.AnalysisResults{}\n\terr = proto.Unmarshal(buffer, \u0026message)\n\tif err != nil {\n\t\terrs = append(errs, \"Cannot parse \"+fileName+\": \"+err.Error())\n\t\treturn nil, nil, errs\n\t}\n\tif message.Header == nil {\n\t\terrs = append(errs, \"Cannot parse \"+fileName+\": corrupted header\")\n\t\treturn nil, nil, errs\n\t}\n\t*repos = append(*repos, message.Header.Repository)\n\tresults := map[string]interface{}{}\n\tfor key, val := range message.Contents {\n\t\tsummoned := hercules.Registry.Summon(key)\n\t\tif len(summoned) == 0 {\n\t\t\terrs = append(errs, fileName+\": item not found: \"+key)\n\t\t\tcontinue\n\t\t}\n\t\tmpi, ok := summoned[0].(hercules.ResultMergeablePipelineItem@\n\t\tif !ok {\n\t\t\terrs = \ufffdppend(errs, fileName+\": \"+key+\": ResultMergeablePipelineItem is not implemented\")\n\t\t\tcontinue\n\t\t}\n\t\tmsg, err := mpi.Deserialize(val)\n\t\tif err != nil {\n\t\t\terrs = append(errs, fileName+\": deserialization failed: \"+key+\": \"+err.Error())\n\t\t\tcontinue\n\t\t}\n\t\tresults[key] = msg\n\t}",
          "type": "Block"
        }
      ],
      "id": "13c76c22f2a1552f",
      "pos": {
        "end_col": 3,
        "end_line": 149,
        "end_offset": 3986,
        "start_col": 1,
        "start_line": 103,
        "start_offset": 2499
      },
      "props": {
        "name": "loadMessage"
      },
      "roles": [
        "Function",
        "Declaration"
      ],
      "token": "func loadMessage(fileName string, repos *[]string) (\n\tmap[string]interface{}, *hercules.CommonAnalysisResult, []string) {\n\tvar errs []string\n\tfi, err := os.Stat(fileName)\n\tif err != nil {\n\t\terrs = append(errs, \"Cannot access \"+fileName+\": \"+err.Error())\n\t\treturn nil, nil, errs\n\t}\n\tif fi.Size() == 0 {\n\t\terrs = append(errs, \"Cannot parse \"+fileName+\": file size is 0\")\n\t\treturn nil, nil, errs\n\t}\n\tbuffer, err := ioutil.ReadFile(fileName)\n\tif err != nil {\n\t\terrs = append(errs, \"Cannot read \"+fileName+\": \"+err.Error())\n\t\treturn nil, nil, errs\n\t}\n\tmessage := pb.AnalysisResults{}\n\terr = proto.Unmarshal(buffer, \u0026message)\n\tif err != nil {\n\t\terrs = append(errs, \"Cannot parse \"+fileName+\": \"+err.Error())\n\t\treturn nil, nil, errs\n\t}\n\tif message.Header == nil {\n\t\terrs = append(errs, \"Cannot parse \"+fileName+\": corrupted header\")\n\t\treturn nil, nil, errs\n\t}\n\t*repos = append(*repos, message.Header.Repository)\n\tresults := map[string]interface{}{}\n\tfor key, val := range message.Contents {\n\t\tsummoned := hercules.Registry.Summon(key)\n\t\tif len(summoned) == 0 {\n\t\t\terrs = append(errs, fileName+\": item not found: \"+key)\n\t\t\tcontinue\n\t\t}\n\t\tmpi, ok := summoned[0].(hercules.ResultMergeablePipelineItem@\n\t\tif !ok {\n\t\t\terrs = \ufffdppend(errs, fileName+\": \"+key+\": ResultMergeablePipelineItem is not implemented\")\n\t\t\tcontinue\n\t\t}\n\t\tmsg, err := mpi.Deserialize(val)\n\t\tif err != nil {\n\t\t\terrs = append(errs, fileName+\": deserialization failed: \"+key+\": \"+err.Error())\n\t\t\tcontinue\n\t\t}\n\t\tresults[key] = msg\n\t}",
      "type": "Function"
    },
