                                                  "token": "{\n\t\t\tfile, err := os.Open(files[0])\n\t\t\tif err != nil {\n\t\t\t\tpanic(err)\n\t\t\t}\n\t\t\tdefer file.Close()\n\t\t\t_, err = io.Copy(os.Stdout, bufio.NewReader(file))\n\t\t\tif err != nil {\n\t\t\t\tpanic(err)\n\t\t\t}\n\t\t\treturn\n\t\t}",
                                                  "type": "Block"
                                                }
