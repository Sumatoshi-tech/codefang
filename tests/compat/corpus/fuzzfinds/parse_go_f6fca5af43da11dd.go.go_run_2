= hercules.Registry.Summon(key)[0].(hercules.LeafPipelineItem).Serialize(\n\t\t\t\tval, true, \u0026buffer)\n\t\t\tif err != nil {\n\t\t\t\tpanic(err)\n\t\t\t}\n\t\t\tmergedMessage.Contents[key] = buffer.Bytes()\n\t\t}\n\t\tserialized, err := proto.Marshal(\u0026mergedMessage)\n\t\tif err != nil {\n\t\t\tpanic(err)\n\t\t}\n\t\tos.Stdout.Write(serialized)\n\t}",
