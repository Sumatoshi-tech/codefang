{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "files": ["**/*.md"],
  "ignorePaths": [
    "node_modules/**",
    "build/**",
    "vendor/**",
    "third_party/**",
    ".github/styles/**",
    "CHANGELOG.md"
  ],
  "dictionaries": ["en_US", "softwareTerms", "go", "filetypes"],
  "words": [
    "codefang",
    "Sumatoshi",
    "hercules",
    "abandonware",
    "burndown",
    "couples",
    "shotness",
    "Halstead",
    "LCOM",
    "cohesion",
    "anomaly",
    "uast",
    "UAST",
    "libgit",
    "libgit2",
    "treesitter",
    "enry",
    "linguist",
    "goreleaser",
    "mkdocs",
    "godoc",
    "pkgsite",
    "gosec",
    "golangci",
    "deadcode",
    "filestats",
    "hibernate",
    "blob",
    "blobs",
    "monorepo",
    "OTEL",
    "otel",
    "opentelemetry",
    "MCP",
    "mcp",
    "stdio",
    "stdout",
    "stdin",
    "JSONC",
    "jsonc",
    "lychee",
    "lycheeignore",
    "markdownlint",
    "cspell",
    "Vale",
    "Diataxis",
    "Diátaxis",
    "MADR",
    "Nygard",
    "OpenSSF",
    "CHAOSS",
    "DCO",
    "semver",
    "changelog",
    "vettool",
    "cgo",
    "CGO",
    "pprof",
    "goroutine",
    "goroutines",
    "tick",
    "ticks",
    "devs",
    "LRU",
    "hibernatable",
    "timeseries"
  ],
  "ignoreRegExpList": [
    "/\\b[0-9a-f]{7,40}\\b/",
    "/`[^`]+`/",
    "/\\]\\([^)]*\\)/"
  ]
}
