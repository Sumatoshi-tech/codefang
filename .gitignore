# Root-anchored: this was the Go module's top-level vendor/ dir. Anchoring keeps
# it from swallowing crates/cf-uast/vendor/, whose tree-sitter grammar sources
# are compiled into the build and must be tracked.
/vendor
cmd/codefang/plugin_template_source.go
coverage.txt
build/bin/codefang
build/bin/uast
python/dist
python/build

**/*.egg-info
**/__pycache__
**/.DS_Store
.idea

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# Folders
_obj
_test

# Architecture specific extensions/prefixes
*.[568vq]
[568vq].out

*.cgo1.go
*.cgo2.c
_cgo_defun.c
_cgo_gotypes.go
_cgo_export.*

_testmain.go

*.exe
*.test
*.prof

*.log

*.tsv
*.tsv.gz
*.rawast.json

# Vendored/fixture data tables live under *.tsv but are consumed by the build
# (include_str!/build.rs) and tests, so they must be tracked despite the blanket
# *.tsv rule above.
!crates/cf-langpath/data/enry-v2.1.0.tsv
!crates/cf-langpath/data/enry-frequencies-v2.1.0.tsv
!crates/cf-langpath/data/enry-interpreters-v2.1.0.tsv
!crates/cf-sentiment-lexicons/data/**
!crates/cf-gojson/tests/oracle_data/**

**/__pycache__
debug*
test/data/
temp_repo/
test/benchmark_plots/
test_submodule/

third_party/grammars/
grammars_json/
third_party/go-sitter-forest/
test/benchmarks/
test/benchmarks/benchmark_results.txt
debug/
build/bin/
build.log
.backend.pid
.vite.pid
playwright-report/
node_modules/
test-results/
core.test
node.test
uast.test
plumbing.test
shotness.test
burndown.test
imports.test
history.test
tree.test
blob.test
ticks.test
leaves.test
identity.test
instructions/
specs/

# MkDocs build output
build/

# Editor/IDE configs
.cursor/
.vscode/
coverage.out
profiles/
.promptkit
.tmp

# Rust workspace
/target
**/*.rs.bk
Cargo.lock.orig

# Compat harness run artifacts (regenerated; not source)
tests/compat/results/

# Vendored tree-sitter grammars are compiled into cf-uast and must be tracked in
# full (parser.c/scanner.c, headers, queries, grammar.json). This scoped
# negation overrides the stale Go-era rules above (e.g. *.[568vq], *.a) that
# would otherwise drop build-critical files from the vendor tree.
!crates/cf-uast/vendor/**
